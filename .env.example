# =============================================================================
# AgentProof Sentinel - Environment Configuration
# Network: Solana Mainnet
# Protocol: SAID Protocol (5dpw6KEQPn248pnkkaYyWfHwu2nfb3LUMbTucb6LaA8G)
# =============================================================================

# Sentinel's own SAID Agent Solana Wallet Address (Base58 public key only)
# Used for display and self-verification check against SAID Protocol
SAID_AGENT_WALLET_ADDRESS=

# Solana Mainnet RPC Endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# PostgreSQL Database Connection String (e.g. Neon, Supabase, local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel

# SAID Protocol API Base URL
SAID_API_BASE_URL=https://api.saidprotocol.com

# Autonomous Monitoring Parameters
MONITOR_INTERVAL_MINUTES=5
MONITOR_TIMEOUT_MS=8000

# SAID Trust Screen x402 Payment Flow (false by default)
ENABLE_X402=false

# Secret token required to trigger automated monitoring via /api/cron/monitor
CRON_SECRET=

# SERVER-ONLY: Optional Solana payment private key for machine-payable x402 queries
# NEVER use NEXT_PUBLIC_ or VITE_ prefix. Must NEVER be committed or exposed to browser.
SENTINEL_SERVER_PAYMENT_KEY=
